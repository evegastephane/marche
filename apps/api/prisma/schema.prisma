generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js" // imports compatibles "nodenext"
}

datasource db {
  provider = "postgresql" // l'URL est dans prisma.config.ts (Prisma 7)
}

// ───────────── Enums ─────────────
enum MemberRole {
  OWNER
  ADMIN
  STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MediaStatus {
  PENDING
  READY
  FAILED
}

enum StockMovementType {
  INITIAL
  RECEIPT
  ADJUSTMENT
  LOSS
  SALE
  RETURN
}

enum OrderStatus {
  DRAFT
  PLACED
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum OrderSource {
  ADMIN
  STOREFRONT
}

enum SiteStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

// ───────────── identity / stores ─────────────
model User {
  id          String        @id @default(uuid(7)) @db.Uuid
  clerkUserId String        @unique @map("clerk_user_id")
  email       String
  firstName   String?       @map("first_name")
  lastName    String?       @map("last_name")
  imageUrl    String?       @map("image_url")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")
  memberships StoreMember[]

  @@map("users")
}

model Store {
  id               String    @id @default(uuid(7)) @db.Uuid
  clerkOrgId       String    @unique @map("clerk_org_id")
  name             String
  slug             String    @unique // = sous-domaine
  currency         String    @db.Char(3) // ISO 4217
  country          String    @db.Char(2) // ISO 3166-1
  timezone         String    @default("Europe/Paris")
  contactEmail     String?   @map("contact_email")
  phone            String?
  logoMediaId      String?   @map("logo_media_id") @db.Uuid
  shippingSettings Json      @default("{\"strategy\":\"FLAT_RATE\",\"flatRateAmount\":0}") @map("shipping_settings")
  lowStockDefault  Int       @default(5) @map("low_stock_default")
  /// Mode ou Électronique : sortes d'articles, options et fiche produit du site.
  type             StoreType @default(FASHION)
  /// Réglages propres au type (guides des tailles…), validés par verticalSettingsSchema.
  verticalSettings Json      @default("{}") @map("vertical_settings")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  archivedAt       DateTime? @map("archived_at")

  members         StoreMember[]
  counter         StoreCounter?
  brands          Brand[]
  products        Product[]
  variants        ProductVariant[]
  media           Media[]
  collections     Collection[]
  customers       Customer[]
  orders          Order[]
  campaigns       Campaign[]
  bundles         Bundle[]
  specialRequests SpecialRequest[]
  categories      Category[]
  attributes      Attribute[]
  apiKeys         ApiKey[]
  site            Site?

  @@map("stores")
}

model StoreMember {
  storeId   String     @map("store_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      MemberRole
  createdAt DateTime   @default(now()) @map("created_at")
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storeId, userId])
  @@index([userId])
  @@map("store_members")
}

model StoreCounter {
  storeId  String @id @map("store_id") @db.Uuid
  orderSeq Int    @default(1000) @map("order_seq") // 1re commande = #1001
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_counters")
}

// ───────────── catalog ─────────────
model Brand {
  id          String    @id @default(uuid(7)) @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  name        String
  slug        String
  description String?
  logoMediaId String?   @map("logo_media_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  archivedAt  DateTime? @map("archived_at")
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([storeId, slug])
  @@index([storeId, name])
  @@map("brands")
}

model Product {
  id              String              @id @default(uuid(7)) @db.Uuid
  storeId         String              @map("store_id") @db.Uuid
  brandId         String?             @map("brand_id") @db.Uuid
  title           String
  slug            String
  description     String? // Markdown
  status          ProductStatus       @default(DRAFT)
  /// Catégorie dynamique (arbre de la boutique) : décide des attributs proposés.
  categoryId      String              @map("category_id") @db.Uuid
  /// Référence du modèle (« sku parent », ex. IP17P) : préfixe des SKU proposés, clé de l'import.
  reference       String?
  warrantyMonths  Int?                @map("warranty_months")
  /// Fiche technique : { slug d'attribut : valeur }, validée par les attributs de la catégorie.
  specs           Json                @default("{}")
  seoTitle        String?             @map("seo_title")
  seoDescription  String?             @map("seo_description")
  publishedAt     DateTime?           @map("published_at")
  version         Int                 @default(0)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  archivedAt      DateTime?           @map("archived_at")
  store           Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brand           Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category        Category            @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  variants        ProductVariant[]
  media           ProductMedia[]
  collections     CollectionProduct[]
  relations       ProductRelation[]   @relation("RelationOwner")
  relatedTo       ProductRelation[]   @relation("RelationTarget")
  bundlesAnchored Bundle[]
  bundleItems     BundleItem[]

  @@unique([storeId, slug])
  @@unique([storeId, reference])
  @@index([storeId, status, updatedAt(sort: Desc)])
  @@index([storeId, brandId])
  @@index([storeId, categoryId, status])
  @@index([specs(ops: JsonbPathOps)], type: Gin, map: "products_specs_gin")
  // Recherche par titre (ILIKE accéléré) : déclaré ici pour que prisma migrate ne le supprime plus
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_title_trgm")
  @@map("products")
}

model ProductVariant {
  id              String          @id @default(uuid(7)) @db.Uuid
  storeId         String          @map("store_id") @db.Uuid
  productId       String          @map("product_id") @db.Uuid
  sku             String
  title           String // "M / Rouge" ou "Par défaut"
  /// Valeurs des axes : { "stockage": "256 Go", "couleur": "Noir" } ; {} pour la variante par défaut.
  options         Json            @default("{}")
  /// Combinaison normalisée (couleur=noir|stockage=256 go) : une seule variante par combinaison.
  combinationKey  String          @map("combination_key")
  costAmount      Int?            @map("cost_amount") // prix d'achat
  barcode         String?
  imageMediaId    String?         @map("image_media_id") @db.Uuid
  priceAmount     Int             @map("price_amount") // unités mineures, devise de la boutique
  compareAtAmount Int?            @map("compare_at_amount")
  position        Int             @default(0)
  trackInventory  Boolean         @default(true) @map("track_inventory")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  archivedAt      DateTime?       @map("archived_at")
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageMedia      Media?          @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  inventory       InventoryLevel?
  movements       StockMovement[]
  units           StockUnit[]
  orderLines      OrderLine[]

  @@unique([storeId, sku])
  @@unique([productId, combinationKey])
  @@index([productId, position])
  @@index([storeId, barcode])
  @@index([options(ops: JsonbPathOps)], type: Gin, map: "product_variants_options_gin")
  @@map("product_variants")
}

model Media {
  id         String           @id @default(uuid(7)) @db.Uuid
  storeId    String           @map("store_id") @db.Uuid
  key        String           @unique // clé d'objet S3 : {storeId}/{mediaId}/original.{ext}
  mimeType   String           @map("mime_type")
  sizeBytes  Int              @map("size_bytes")
  width      Int?
  height     Int?
  alt        String?
  status     MediaStatus      @default(PENDING)
  renditions Json             @default("{}") // { "400": "…webp", "800": "…", "1600": "…" }
  createdAt  DateTime         @default(now()) @map("created_at")
  store      Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products   ProductMedia[]
  variants   ProductVariant[]

  @@index([storeId, createdAt(sort: Desc)])
  @@map("media")
}

model ProductMedia {
  storeId     String  @map("store_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  mediaId     String  @map("media_id") @db.Uuid
  position    Int
  /// Valeur d'option (une couleur) que montre la photo ; null = toutes.
  optionValue String? @map("option_value")
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media       Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@index([productId, position])
  @@map("product_media")
}

model Collection {
  id           String              @id @default(uuid(7)) @db.Uuid
  storeId      String              @map("store_id") @db.Uuid
  title        String
  slug         String
  description  String?
  imageMediaId String?             @map("image_media_id") @db.Uuid
  isPublished  Boolean             @default(true) @map("is_published")
  position     Int                 @default(0) // ordre dans la navigation du site
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products     CollectionProduct[]

  @@unique([storeId, slug])
  @@index([storeId, position])
  @@map("collections")
}

model CollectionProduct {
  storeId      String     @map("store_id") @db.Uuid
  collectionId String     @map("collection_id") @db.Uuid
  productId    String     @map("product_id") @db.Uuid
  position     Int
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([collectionId, position])
  @@index([productId])
  @@map("collection_products")
}

// ───────────── catalog : catégories et attributs (définis par chaque boutique) ─────────────

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  BOOLEAN
}

/// Catégorie de produits, rangée en arbre. Elle hérite des attributs de ses parents.
model Category {
  id          String              @id @default(uuid(7)) @db.Uuid
  storeId     String              @map("store_id") @db.Uuid
  parentId    String?             @map("parent_id") @db.Uuid
  name        String
  slug        String
  position    Int                 @default(0)
  /// Suivi à l'unité (IMEI ou numéro de série), transmis aux sous-catégories.
  tracksUnits Boolean             @default(false) @map("tracks_units")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  archivedAt  DateTime?           @map("archived_at")
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent      Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction)
  children    Category[]          @relation("CategoryTree")
  attributes  CategoryAttribute[]
  products    Product[]

  @@unique([storeId, slug])
  @@index([storeId, parentId, position])
  @@map("categories")
}

/// Attribut d'une fiche produit. Un axe de variante (couleur, stockage…) fait varier prix et stock ;
/// les autres attributs décrivent le produit dans products.specs.
model Attribute {
  id            String              @id @default(uuid(7)) @db.Uuid
  storeId       String              @map("store_id") @db.Uuid
  name          String
  /// Clé dans products.specs et product_variants.options : figée dès que l'attribut sert.
  slug          String
  type          AttributeType
  /// Unité d'un nombre (W, mAh, h…) ; indicative pour une liste.
  unit          String?
  isVariantAxis Boolean             @default(false) @map("is_variant_axis")
  /// Proposé comme filtre sur le site.
  filterable    Boolean             @default(false)
  position      Int                 @default(0)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  archivedAt    DateTime?           @map("archived_at")
  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  values        AttributeValue[]
  categories    CategoryAttribute[]

  @@unique([storeId, slug])
  @@index([storeId, position])
  @@map("attributes")
}

/// Attribut proposé par une catégorie (et ses sous-catégories).
model CategoryAttribute {
  storeId     String    @map("store_id") @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  attributeId String    @map("attribute_id") @db.Uuid
  /// Obligatoire pour publier le produit.
  required    Boolean   @default(false)
  position    Int       @default(0)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
  @@index([attributeId])
  @@index([storeId])
  @@map("category_attributes")
}

/// Valeur proposée d'un attribut de type liste (SELECT, MULTI_SELECT).
model AttributeValue {
  id          String    @id @default(uuid(7)) @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  attributeId String    @map("attribute_id") @db.Uuid
  value       String
  /// Segment de SKU (Noir → BLK, 256 Go → 256).
  code        String
  /// Pastille d'une couleur : #RRGGBB.
  swatch      String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, value])
  @@index([attributeId, position])
  @@index([storeId])
  @@map("attribute_values")
}

// ───────────── inventory ─────────────
model InventoryLevel {
  variantId         String         @id @map("variant_id") @db.Uuid
  storeId           String         @map("store_id") @db.Uuid
  onHand            Int            @default(0) @map("on_hand")
  reserved          Int            @default(0)
  lowStockThreshold Int?           @map("low_stock_threshold") // null ⇒ Store.lowStockDefault
  /// Variante suivie à l'unité (IMEI) : son stock ne bouge que par l'entrée ou la sortie d'unités.
  tracksUnits       Boolean        @default(false) @map("tracks_units")
  version           Int            @default(0)
  updatedAt         DateTime       @updatedAt @map("updated_at")
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("inventory_levels")
}

model StockMovement {
  id          String            @id @default(uuid(7)) @db.Uuid
  storeId     String            @map("store_id") @db.Uuid
  variantId   String            @map("variant_id") @db.Uuid
  type        StockMovementType
  quantity    Int // signé : +10, -3
  onHandAfter Int               @map("on_hand_after")
  reason      String?
  orderId     String?           @map("order_id") @db.Uuid
  actorUserId String?           @map("actor_user_id") @db.Uuid
  /// Unité (IMEI) entrée ou sortie par ce mouvement, pour une variante suivie à l'unité.
  stockUnitId String?           @map("stock_unit_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stockUnit   StockUnit?        @relation(fields: [stockUnitId], references: [id], onDelete: SetNull)

  @@index([storeId, variantId, createdAt(sort: Desc)])
  @@index([stockUnitId])
  @@map("stock_movements")
}

enum UnitCondition {
  NEW
  USED
}

enum StockUnitStatus {
  IN_STOCK
  SOLD
  REMOVED
}

/// Appareil suivi à l'unité (téléphone, console, ordinateur) : IMEI ou numéro de série.
/// Le stock d'une variante suivie = nombre de ses unités IN_STOCK (chaque entrée ou sortie est un mouvement).
model StockUnit {
  id            String          @id @default(uuid(7)) @db.Uuid
  storeId       String          @map("store_id") @db.Uuid
  variantId     String          @map("variant_id") @db.Uuid
  /// IMEI ou numéro de série (majuscules, sans espaces), unique dans la boutique.
  serial        String
  /// Neuf ou d'occasion : découle de l'axe État de la variante.
  condition     UnitCondition   @default(NEW)
  /// Santé de la batterie (%), pour un appareil d'occasion.
  batteryHealth Int?            @map("battery_health")
  status        StockUnitStatus @default(IN_STOCK)
  notes         String?
  /// Ligne de commande qui a vendu l'unité.
  orderLineId   String?         @map("order_line_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  variant       ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements     StockMovement[]

  @@unique([storeId, serial])
  @@index([variantId, status])
  @@map("stock_units")
}

// ───────────── orders ─────────────
model Customer {
  id               String            @id @default(uuid(7)) @db.Uuid
  storeId          String            @map("store_id") @db.Uuid
  email            String // normalisé en minuscules
  firstName        String?           @map("first_name")
  lastName         String?           @map("last_name")
  phone            String?
  defaultAddress   Json?             @map("default_address")
  /// Consentement aux nouveautés par WhatsApp (case cochée au paiement), et désinscription (« STOP »).
  whatsappOptInAt  DateTime?         @map("whatsapp_opt_in_at")
  whatsappOptOutAt DateTime?         @map("whatsapp_opt_out_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders           Order[]
  campaignMessages CampaignMessage[]

  @@unique([storeId, email])
  @@index([storeId, lastName])
  @@map("customers")
}

model Order {
  id              String          @id @default(uuid(7)) @db.Uuid
  storeId         String          @map("store_id") @db.Uuid
  number          Int? // attribué au passage (DRAFT ⇒ null)
  publicToken     String          @unique @map("public_token") // lien de suivi acheteur (32 octets base64url)
  customerId      String?         @map("customer_id") @db.Uuid
  email           String? // instantané
  status          OrderStatus     @default(DRAFT)
  paymentStatus   PaymentStatus   @default(UNPAID) @map("payment_status")
  source          OrderSource
  currency        String          @db.Char(3)
  subtotalAmount  Int             @default(0) @map("subtotal_amount")
  /// Remises des packs, figées au passage : [{ bundleId, title, amount }].
  discounts       Json            @default("[]")
  discountAmount  Int             @default(0) @map("discount_amount")
  shippingAmount  Int             @default(0) @map("shipping_amount")
  totalAmount     Int             @default(0) @map("total_amount")
  shippingAddress Json?           @map("shipping_address")
  shippingMethod  String?         @map("shipping_method")
  note            String?
  cancelReason    String?         @map("cancel_reason")
  placedAt        DateTime?       @map("placed_at")
  paidAt          DateTime?       @map("paid_at")
  fulfilledAt     DateTime?       @map("fulfilled_at")
  cancelledAt     DateTime?       @map("cancelled_at")
  version         Int             @default(0)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines           OrderLine[]
  specialRequest  SpecialRequest?

  @@unique([storeId, number])
  @@index([storeId, status, createdAt(sort: Desc)])
  @@index([storeId, customerId])
  @@map("orders")
}

model OrderLine {
  id              String          @id @default(uuid(7)) @db.Uuid
  storeId         String          @map("store_id") @db.Uuid
  orderId         String          @map("order_id") @db.Uuid
  variantId       String?         @map("variant_id") @db.Uuid
  productTitle    String          @map("product_title") // instantané [R6]
  variantTitle    String          @map("variant_title")
  sku             String
  unitPriceAmount Int             @map("unit_price_amount")
  quantity        Int
  lineTotalAmount Int             @map("line_total_amount")
  tracksInventory Boolean         @default(true) @map("tracks_inventory") // la ligne a réservé du stock
  custom          Boolean         @default(false) // ligne libre (commande sur demande), hors catalogue
  serialNumbers   String[]        @default([]) @map("serial_numbers") // IMEI ou n° de série notés à l'expédition
  position        Int
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId, position])
  @@index([storeId, variantId])
  @@map("order_lines")
}

// ───────────── sites ─────────────
model Site {
  id                 String     @id @default(uuid(7)) @db.Uuid
  storeId            String     @unique @map("store_id") @db.Uuid
  subdomain          String     @unique
  templateId         String     @default("default") @map("template_id")
  templateVersion    String     @map("template_version")
  themeSettings      Json       @map("theme_settings") // en ligne
  draftThemeSettings Json       @map("draft_theme_settings") // en cours d'édition
  status             SiteStatus @default(DRAFT)
  publishedAt        DateTime?  @map("published_at")
  customDomain       String?    @unique @map("custom_domain") // V2
  version            Int        @default(0)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  store              Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("sites")
}

// ───────────── outbox ─────────────
model OutboxEvent {
  id          String    @id @db.Uuid // = id de l'événement de domaine
  storeId     String?   @map("store_id") @db.Uuid
  type        String
  aggregateId String    @map("aggregate_id")
  payload     Json
  occurredAt  DateTime  @map("occurred_at")
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([occurredAt])
  @@map("outbox_events")
}

enum CampaignStatus {
  SENDING
  DONE
}

enum CampaignMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

/// Campagne WhatsApp : un produit envoyé aux clients qui ont accepté de recevoir les nouveautés.
model Campaign {
  id              String            @id @default(uuid(7)) @db.Uuid
  storeId         String            @map("store_id") @db.Uuid
  productId       String?           @map("product_id") @db.Uuid
  productTitle    String            @map("product_title")
  templateName    String            @map("template_name")
  status          CampaignStatus    @default(SENDING)
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  finishedAt      DateTime?         @map("finished_at")
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages        CampaignMessage[]

  @@index([storeId, createdAt])
  @@map("campaigns")
}

/// Un message d'une campagne, suivi jusqu'à sa lecture par les notifications de Meta.
model CampaignMessage {
  id                String                @id @default(uuid(7)) @db.Uuid
  storeId           String                @map("store_id") @db.Uuid
  campaignId        String                @map("campaign_id") @db.Uuid
  customerId        String?               @map("customer_id") @db.Uuid
  /// Numéro international sans « + » (format attendu par WhatsApp).
  phone             String
  firstName         String?               @map("first_name")
  status            CampaignMessageStatus @default(QUEUED)
  providerMessageId String?               @unique @map("provider_message_id")
  error             String?
  sentAt            DateTime?             @map("sent_at")
  deliveredAt       DateTime?             @map("delivered_at")
  readAt            DateTime?             @map("read_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  campaign          Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer          Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([storeId])
  @@map("campaign_messages")
}

enum StoreType {
  FASHION
  ELECTRONICS
}

enum ProductRelationType {
  ACCESSORY
}

/// Lien entre deux produits : accessoires choisis à la main pour un appareil.
model ProductRelation {
  storeId          String              @map("store_id") @db.Uuid
  productId        String              @map("product_id") @db.Uuid
  relatedProductId String              @map("related_product_id") @db.Uuid
  type             ProductRelationType @default(ACCESSORY)
  position         Int
  product          Product             @relation("RelationOwner", fields: [productId], references: [id], onDelete: Cascade)
  related          Product             @relation("RelationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId, type])
  @@index([relatedProductId])
  @@index([storeId])
  @@map("product_relations")
}

enum BundleDiscountType {
  PERCENT
  AMOUNT
}

/// Pack : un appareil et des accessoires vendus ensemble, avec une remise.
model Bundle {
  id              String             @id @default(uuid(7)) @db.Uuid
  storeId         String             @map("store_id") @db.Uuid
  title           String
  anchorProductId String             @map("anchor_product_id") @db.Uuid
  discountType    BundleDiscountType @map("discount_type")
  discountValue   Int                @map("discount_value")
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  store           Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  anchor          Product            @relation(fields: [anchorProductId], references: [id], onDelete: Cascade)
  items           BundleItem[]

  @@index([storeId, isActive])
  @@index([anchorProductId])
  @@map("bundles")
}

model BundleItem {
  storeId   String  @map("store_id") @db.Uuid
  bundleId  String  @map("bundle_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  position  Int
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([bundleId, productId])
  @@index([productId])
  @@map("bundle_items")
}

enum SpecialRequestStatus {
  NEW
  QUOTED
  DECLINED
  CONVERTED
}

enum SpecialRequestType {
  CONFIGURATION
  TRADE_IN
  MADE_TO_MEASURE
}

/// Commande sur demande : une configuration absente du stock, demandée depuis le site.
model SpecialRequest {
  id                    String               @id @default(uuid(7)) @db.Uuid
  storeId               String               @map("store_id") @db.Uuid
  productId             String?              @map("product_id") @db.Uuid
  productTitle          String               @map("product_title")
  productSlug           String?              @map("product_slug")
  /// Configuration souhaitée : [{ name, value }].
  options               Json                 @default("[]")
  quantity              Int
  firstName             String               @map("first_name")
  lastName              String?              @map("last_name")
  email                 String
  phone                 String
  note                  String?
  /// Mesures du client (sur mesure) ou appareil repris : [{ name, value }].
  details               Json                 @default("[]")
  type                  SpecialRequestType   @default(CONFIGURATION)
  currency              String               @db.Char(3)
  status                SpecialRequestStatus @default(NEW)
  quotedUnitPriceAmount Int?                 @map("quoted_unit_price_amount")
  quotedDelay           String?              @map("quoted_delay")
  declineReason         String?              @map("decline_reason")
  orderId               String?              @unique @map("order_id") @db.Uuid
  version               Int                  @default(0)
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  store                 Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order                 Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([storeId, status, createdAt(sort: Desc)])
  @@map("special_requests")
}

// ───────────── devices (catalogue partagé, hors boutique) ─────────────

/// Fiche d'un appareil connu (téléphone, tablette, montre…), partagée par toutes les boutiques.
/// Une fiche importée d'un service en ligne y reste : les boutiques suivantes la trouvent sans nouvelle requête.
model DeviceModel {
  id          String   @id @default(uuid(7)) @db.Uuid
  provider    String // « mobileapi »
  providerId  String   @map("provider_id")
  brand       String
  name        String
  /// Nom complet normalisé (« apple iphone 12 ») pour la recherche.
  searchName  String   @map("search_name")
  kind        String // PHONE, TABLET, WATCH, COMPUTER
  year        Int?
  attributes  Json
  storages    String[] @default([])
  colors      Json     @default("[]")
  description String
  /// Réponse brute du service, gardée pour réinterpréter la fiche sans nouvelle requête.
  raw         Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerId])
  @@index([searchName])
  @@map("device_models")
}

// ───────────── developers (clés d'API) ─────────────

enum ApiKeyKind {
  PUBLISHABLE
  SECRET
}

/// Clé d'API d'une boutique. pk_ (publique) : le site ou l'application d'un tiers lit le catalogue et
/// passe commande depuis le navigateur, limitée aux origines déclarées. sk_ (secrète) : un serveur
/// appelle l'API d'administration avec les droits accordés. Seule l'empreinte SHA-256 est gardée ;
/// la clé secrète n'est montrée qu'une fois, à la création.
model ApiKey {
  id             String     @id @default(uuid(7)) @db.Uuid
  storeId        String     @map("store_id") @db.Uuid
  name           String
  kind           ApiKeyKind
  /// Empreinte SHA-256 (hex) de la clé complète : sert à la retrouver.
  tokenHash      String     @unique @map("token_hash")
  /// Clé publique en clair (réaffichable) ; null pour une clé secrète.
  token          String?
  /// Début et fin de la clé (« sk_…3f9a ») pour la reconnaître sans la révéler.
  prefix         String
  last4          String
  /// Droits d'une clé secrète : catalog:read, orders:write…
  scopes         String[]   @default([])
  /// Origines autorisées d'une clé publique (https://www.exemple.com).
  allowedOrigins String[]   @default([]) @map("allowed_origins")
  lastUsedAt     DateTime?  @map("last_used_at")
  createdById    String?    @map("created_by_id") @db.Uuid
  revokedAt      DateTime?  @map("revoked_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  store          Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("api_keys")
}
