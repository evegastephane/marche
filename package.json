{
  "name": "marche",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=26",
    "npm": ">=12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "depcruise": "depcruise apps/api/src packages/contracts/src --config .dependency-cruiser.cjs --output-type err-long"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.4.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "turbo": "^2.11.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/engines": false,
    "@scarf/scarf": false,
    "cpu-features": false,
    "esbuild": false,
    "msgpackr-extract": false,
    "prisma": false,
    "protobufjs": false,
    "ssh2": false
  }
}
