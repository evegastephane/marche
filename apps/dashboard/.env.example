# Dashboard marchand (docs/PLAN-CODE.md §4.3). Copier en .env.local.
VITE_API_URL=http://localhost:3000
# Clé publique de l'application Clerk de dev (clerk init l'écrit dans .env.local)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_remplacer
# Domaine des sites générés : {slug}.<domaine>
VITE_PLATFORM_ROOT_DOMAIN=localhost:3001
VITE_SITE_URL_SCHEME=http
# Adresse de l'équipe Upsell qui active la formule Premium (bouton « Écrire à l'équipe » de la page Modèles).
# Vide : pas de lien, le dialogue explique seulement la marche à suivre.
VITE_SUPPORT_EMAIL=
