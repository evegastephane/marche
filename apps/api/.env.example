# Variables de l'API et du worker (docs/PLAN-CODE.md §4.3)
# Copier en .env et compléter. L'API valide ces variables au démarrage.

NODE_ENV=development
PORT=3000

# ── Données ──
DATABASE_URL=postgresql://marche:marche@localhost:5434/marche
REDIS_URL=redis://localhost:6379

# ── Clerk ──
CLERK_SECRET_KEY=sk_test_remplacer
# Optionnel : clé publique PEM pour vérifier les JWT sans appel réseau
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
CLERK_WEBHOOK_SIGNING_SECRET=whsec_remplacer

# ── WhatsApp (Meta) : webhook https://<domaine>/webhooks/whatsapp ──
# Jeton de vérification : un mot secret que vous choisissez, saisi aussi chez Meta (« Vérifier le token »).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Clé secrète de l'app Meta (Paramètres de l'app → Général) : vérifie la signature des notifications.
WHATSAPP_APP_SECRET=
# Envoi des campagnes (page Campagnes du dashboard). Jeton permanent : utilisateur système Meta,
# permissions whatsapp_business_messaging et whatsapp_business_management.
WHATSAPP_ACCESS_TOKEN=
# Identifiant du numéro (WhatsApp → Configuration de l'API → Phone number ID).
WHATSAPP_PHONE_NUMBER_ID=
# Modèle approuvé chez Meta, catégorie Marketing, langue français (fr), corps à 5 paramètres :
#   « Bonjour {{1}} ! Nouveau chez {{2}} : {{3}}, à {{4}}. Découvrez-le ici : {{5}} »
#   {{1}} prénom, {{2}} boutique, {{3}} produit, {{4}} prix, {{5}} lien du produit.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=fr
# true si le modèle a une image d'en-tête (photo du produit, en https public uniquement).
WHATSAPP_TEMPLATE_HEADER_IMAGE=false
WHATSAPP_API_VERSION=v23.0

# ── HTTP ──
CORS_ORIGINS=http://localhost:5173

# ── Stockage objet (RustFS en local, Cloudflare R2 en production) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=marche-media
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/marche-media

# ── E-mail (smtp → Mailpit en dev, resend en production) ──
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
EMAIL_FROM="Marché <no-reply@marche.localhost>"

# ── PostHog (optionnel en dev) ──
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ── Storefront ──
# Secret partagé : le storefront appelle l'API côté serveur uniquement
STOREFRONT_API_TOKEN=remplacer-par-32-octets-aleatoires
STOREFRONT_INTERNAL_URL=http://localhost:3001
REVALIDATE_SECRET=remplacer-par-une-chaine-aleatoire
PREVIEW_TOKEN_SECRET=remplacer-par-une-chaine-aleatoire
PLATFORM_ROOT_DOMAIN=localhost:3001
DASHBOARD_URL=http://localhost:5173
SITE_URL_SCHEME=http

# ── Administration des files (Bull Board sur /admin/queues) ──
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin

# ── @nestjs/observe (optionnel : activé seulement si renseigné) ──
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
