# Sites des boutiques (docs/PLAN-CODE.md §4.3). Copier en .env.local.
# Les valeurs secrètes doivent être identiques à celles de apps/api/.env.
API_INTERNAL_URL=http://localhost:3000
STOREFRONT_API_TOKEN=remplacer-par-le-meme-que-l-api
REVALIDATE_SECRET=remplacer-par-le-meme-que-l-api
# Domaine racine : les boutiques sont servies sur {slug}.<domaine>
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3001
# Adresse du dashboard marchand (lien de la page d'accueil de la plateforme)
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:5173

# Mesure d'audience (facultatif) : sans clé, ni bandeau de consentement ni mesure.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Contact affiché sur la page /confidentialite de la plateforme (facultatif).
NEXT_PUBLIC_PLATFORM_CONTACT_EMAIL=
